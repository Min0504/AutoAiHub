# ─────────────────────────────────────────────────
# Groq AI (필수)
# ─────────────────────────────────────────────────
# Required for AI scenario builder, proposal generator, chatbot
# https://console.groq.com 에서 API 키 발급
GROQ_API_KEY="MY_GROQ_API_KEY"
GROQ_MODEL="llama-3.3-70b-versatile"

# ─────────────────────────────────────────────────
# Supabase — 리드 저장 (프로덕션 권장)
# ─────────────────────────────────────────────────
# 설정 방법:
#   1. https://supabase.com 에서 프로젝트 생성
#   2. supabase/schema.sql 의 SQL을 Supabase SQL Editor에서 실행
#   3. Settings > API 에서 URL과 service_role key 복사
#
# 프로덕션(Vercel)에서는 SUPABASE_URL + SUPABASE_SERVICE_KEY 필수.
# 로컬에서만 미설정 시 ./data/leads.jsonl 로 폴백 저장됨.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# ─────────────────────────────────────────────────
# Slack — 새 리드 알림 (선택)
# ─────────────────────────────────────────────────
# 설정 방법:
#   1. https://api.slack.com/apps 에서 앱 생성
#   2. Incoming Webhooks 활성화 후 채널 선택
#   3. Webhook URL 복사
#
# 없으면 알림 없이 조용히 저장만 됨
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

# ─────────────────────────────────────────────────
# 기타
# ─────────────────────────────────────────────────
# 로컬 Express 포트 (기본 3001)
PORT="3001"

# Supabase 미사용(로컬) 시 JSONL 저장 경로
LEADS_DIR="./data"
LEADS_FILE="./data/leads.jsonl"
