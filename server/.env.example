# AutoHub API 환경변수 — .env로 복사해서 사용 (.env는 gitignore됨)
# 전체 목록과 기본값: src/config/env.ts (zod 스키마가 단일 진실 공급원)

NODE_ENV=development
PORT=4000

# SQLite 파일 경로 (디렉토리는 자동 생성)
DATABASE_PATH=./data/autohub.db

# 운영에서는 반드시 길고 무작위한 값으로 교체 (예: openssl rand -base64 48)
JWT_SECRET=dev-only-secret-change-me-32chars
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=14

# 쉼표 구분 허용 Origin 목록
CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10

LOG_LEVEL=info

# 부팅 시 관리자 계정 자동 생성 (선택)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=changeme123
